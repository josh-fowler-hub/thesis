@article{
mason59,
   Author = {Mason, Edward A. and Vanderslice, Joseph T. and Yos, Jerrold M.},
   Title = {Transport Properties of High-Temperature Multicomponent Gas Mixtures},
   Journal = {The Physics of Fluids},
   Volume = {2},
   Number = {6},
   Pages = {688-694},
   Abstract = {An investigation is made of some modifications in the kinetic theory of gaseous transport properties which are necessary to take account of effect encountered at high temperatures.  In particular, complications arise because of the existence of a multiplicity of different interaction energy curves governing collisions, and because of the possibility of resonant excitation and charge exchange during collisions.  It is shown that the results of classical kinetic theory can be kept in the same form, but the cross sections or collision integrals have to be computed differently.  It is pointed out that the present modifications are valid to all orders of Chapman-Enskog approximation.  It is also shown tha the excitation exchange is important in deermining the transport properties of mixtures at high temperatures, and the method of calculation of the excitation exchange probability is extended to cases for which multiple interaction curves are involved.},
   Keywords = {Cross-Section, diffusion coefficients, collision integrals},
   Month = {Jul 15},
   Year = {1959} }




