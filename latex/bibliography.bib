@misc{
biagi05,
   Author = {Biagi, Stephen},
   Title = {Momentum Transfer Cross Sections},
   Type = {Personal Communication - Email},
   Address = {Liverpool, England},
      Month = {Aug 25},
      Abstract = {Dear Matt,
           I have a data base of x-sections that are used in the magboltz solver. The x-section set uses not only momentum transfer x-sections but also real x-sections. The reason for this is that in some gases the momentum transfer approximation is not good enough at the 1% level of accuracy and the angular distributions must be taken into account. However for MHD applications I would expect the momentum transfer x-sections would be adequate.
 I have attached a gizped fortran listing of magboltz.
There is some descriptions and references in the comments section at the begining of the program that you should read.
The x-sections are listed in the  various relevant gas subroutines. Be careful when reading the subroutines some x-sections are given analytically some are tabulated and some x-sections are mixtures of tables and analytical functions.
 note I have recently added germane and silane to the data base.

  I will be more easily contactable from next week at the following e-mail address:
   stephen.biagi@hotmail.co.uk
    rather than
    sfb@hep.ph.liv.ac.uk
You might also find some nice plots of the x-sections on the cern web
page:
  http://rjd.home.cern.ch/rjd/cgi-bin/cross/
I expect you will have some questions when you have looked at the program do not hesitate to contact me again at the hotmail address
  yours sincerely
  stephen biagi},
      Year = {2005} }




